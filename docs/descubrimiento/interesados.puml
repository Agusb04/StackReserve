@startuml
title Onion Model - Sistema de Reservas de Biblioteca
skinparam packageStyle rectangle
skinparam shadowing false

' Capa externa
rectangle "Wider Environment" {
    rectangle "Servicios de mensajería\n(WhatsApp, etc.)" as I07
    rectangle "Infraestructura tecnológica\n(servidores, red)" as I08
    rectangle "Equipo de IT /\nsoporte técnico" as I09
}

' Capa intermedia
rectangle "Containing System" {
    rectangle "Institución académica" as I04
    rectangle "Responsable de\nnormativas internas" as I05
    rectangle "Servicios de notificación\n(email institucional)" as I06
}

' Núcleo
rectangle "Our System" {
    rectangle "Sistema de reservas" as SYS
    rectangle "Estudiantes" as I01
    rectangle "Personal de biblioteca" as I02
    rectangle "Coordinación de biblioteca" as I03
}

' Relaciones
I01 --> SYS : usa
I02 --> SYS : administra
I03 --> SYS : supervisa
SYS --> I06 : envía notificaciones
SYS --> I04 : responde a políticas
I05 --> SYS : define reglas de negocio
I07 --> SYS : actualmente usado\n(a reemplazar o integrar)
I08 --> SYS : soporta
I09 --> SYS : mantiene

@enduml